# Configure DISCORD_BOT_TOKEN in Replit Secrets. Do not commit a real token.
DISCORD_BOT_TOKEN=MTU1OTA2MzE4NDYxNzM3Mzc2OQ.GJz1pV.eZOWmNJvKSeh3MqhpXdiv8C4KuSZKGYvv9bak4

# Optional: set an application ID to register slash commands without waiting for
# the bot to log in. By default, the application ID is read from the bot user.
DISCORD_APPLICATION_ID=

# Optional: slash commands registered to this development guild update faster.
# Leave empty to register global slash commands.
DISCORD_DEV_GUILD_ID=

# Enable only after the corresponding privileged intent is enabled in the
# Discord Developer Portal. These are ordinary settings, not secrets.
DISCORD_ENABLE_GUILD_MEMBERS_INTENT=false
DISCORD_ENABLE_MESSAGE_CONTENT_INTENT=false

# Optional: SQLite database path. Defaults to ./data/moderation.sqlite
BOT_DATABASE_PATH=
